[Unit]
Description=Camelliera Worker
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/camelliera/worker
EnvironmentFile=/opt/camelliera/worker/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
